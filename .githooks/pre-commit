#!/usr/bin/env bash
# Chặn commit nếu bộ test fail. Bật một lần: git config core.hooksPath .githooks
# Bỏ qua khẩn cấp (không khuyến khích): git commit --no-verify
set -euo pipefail
changed="$(git diff --cached --name-only)"
targets=()
echo "$changed" | grep -qE '^(src/backend/|src/database/|docs/06-|docs/api/)' && targets+=(backend)
echo "$changed" | grep -qE '^src/frontend/' && targets+=(frontend)
echo "$changed" | grep -qE '^src/ai-local/' && targets+=(ai-local)
[ ${#targets[@]} -eq 0 ] && exit 0
for t in "${targets[@]}"; do scripts/test.sh "$t"; done
