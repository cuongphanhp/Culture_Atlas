DATABASE_URL=postgresql+asyncpg://atlas:atlas@db:5432/culture_atlas
POSTGRES_PASSWORD=atlas
JWT_SECRET=change-me
# LLM (core AI): chỉ OpenAI — gpt-6-luna (chính) hoặc gpt-4o. Mọi AI khác (giọng nói, embedding, rerank) chạy local — src/ai-local
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-4o
LLM_REASONING_EFFORT=none
AI_LOCAL_URL=http://localhost:8100
# Tuỳ chọn cho dịch vụ AI local (mặc định đã tốt)
# AI_LOCAL_THREADS=8
# AI_LOCAL_TTS_VOICE=Hải Đăng
# AI_LOCAL_TTS_PRECISION=int8
# AI_LOCAL_PRELOAD=0
GUEST_DAILY_LIMIT=10
REST_COUNTRIES_TOKEN=
SMITHSONIAN_API_KEY=
EUROPEANA_WSKEY=
# Worker thu thập dữ liệu
WORKER_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/culture_atlas
WORKER_MIN_INTERVAL_S=1.0
WORKER_HEADLESS=1
# Lưu trữ (docker compose): ảnh/video/file → object storage MinIO (S3); embedding → Qdrant. Đặt giá trị ngẫu nhiên:
#   openssl rand -hex 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
QDRANT_API_KEY=
# Cách A (chạy ngoài Docker): địa chỉ dịch vụ trên máy chủ
S3_ENDPOINT=localhost:9000
QDRANT_URL=http://localhost:6333
# Cổng publish ra 127.0.0.1 (đổi nếu trùng app khác)
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# QDRANT_PORT=6333
